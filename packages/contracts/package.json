{
  "name": "@pulseops/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, types and the RBAC matrix used by web and api",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "rm -rf dist && tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pulseops/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
