{
  "name": "@pulseops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsc && concurrently -k -n tsc,node \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "rm -rf dist && tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed/seed.ts",
    "generate": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/platform-socket.io": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.3.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@pulseops/contracts": "workspace:^",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@pulseops/config": "workspace:*",
    "@swc/core": "^1.16.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
