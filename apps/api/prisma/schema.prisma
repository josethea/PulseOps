// PulseOps data model (spec section 9).
//
// Multi-tenancy: every business entity carries organizationId, and cross-entity
// relations use composite foreign keys (organizationId + id) so the database itself
// rejects links across tenants (e.g. an incident pointing at another tenant's service).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  ORG_ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum ScenarioKind {
  DEGRADED
  OUTAGE
}

enum ScenarioStatus {
  RUNNING
  FINISHED
  CANCELLED
}

enum Severity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
}

enum AggregationType {
  AVG
  SUM
  MAX
  MIN
  P95
}

enum BucketSize {
  MINUTE
  HOUR
}

enum AlertOperator {
  GT
  GTE
  LT
  LTE
  EQ
}

enum AlertState {
  FIRING
  CLEARED
}

enum NotificationType {
  INCIDENT
  ALERT
}

// ---------------------------------------------------------------- identity & tenancy

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  displayName  String
  // scrypt hash (see auth/password.ts). Null for accounts that cannot sign in with a password.
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  memberships    Membership[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  incidentEvents IncidentEvent[]
  sessions       Session[]
  demoScenarios  DemoScenario[]
}

// Server-side session. Only the SHA-256 hash of the cookie token is stored, so a
// database leak cannot be replayed as a login. Logout deletes the row.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  timezone        String    @default("UTC")
  isDemo          Boolean   @default(false)
  // Last time the demo dataset was restored; throttles the reset action (BR-015).
  lastDemoResetAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  memberships      Membership[]
  services         Service[]
  metricSamples    MetricSample[]
  metricAggregates MetricAggregate[]
  incidents        Incident[]
  incidentEvents   IncidentEvent[]
  alertRules       AlertRule[]
  alertOccurrences AlertOccurrence[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  eventOutbox      EventOutbox[]
  eventSequence    EventSequence?
  demoScenarios    DemoScenario[]
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  assignedIncidents Incident[]  @relation("IncidentAssignee")
  createdIncidents  Incident[]  @relation("IncidentCreator")
  createdAlertRules AlertRule[]

  @@unique([organizationId, userId])
}

// ---------------------------------------------------------------- services & metrics

model Service {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  region         String
  status         ServiceStatus @default(HEALTHY)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  metricSamples    MetricSample[]
  metricAggregates MetricAggregate[]
  incidents        Incident[]
  alertRules       AlertRule[]
  alertOccurrences AlertOccurrence[]
  demoScenarios    DemoScenario[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
}

model MetricDefinition {
  id              String          @id @default(cuid())
  key             String          @unique
  unit            String
  aggregationType AggregationType
  description     String

  samples    MetricSample[]
  aggregates MetricAggregate[]
  alertRules AlertRule[]
}

model MetricSample {
  id             BigInt   @id @default(autoincrement())
  organizationId String
  serviceId      String
  region         String
  metricKey      String
  value          Float
  occurredAt     DateTime @db.Timestamptz(3)
  ingestionAt    DateTime @default(now()) @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service          @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  metric       MetricDefinition @relation(fields: [metricKey], references: [key])

  @@index([organizationId, serviceId, metricKey, occurredAt(sort: Desc)])
  @@index([occurredAt])
}

model MetricAggregate {
  id             BigInt     @id @default(autoincrement())
  organizationId String
  serviceId      String
  region         String
  metricKey      String
  bucketStart    DateTime   @db.Timestamptz(3)
  bucketSize     BucketSize
  min            Float
  max            Float
  avg            Float
  count          Int
  p95            Float?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service          @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  metric       MetricDefinition @relation(fields: [metricKey], references: [key])

  @@unique([organizationId, serviceId, region, metricKey, bucketSize, bucketStart])
  @@index([organizationId, serviceId, bucketStart])
}

// ---------------------------------------------------------------- incidents

model Incident {
  id             String         @id @default(cuid())
  organizationId String
  serviceId      String
  region         String
  title          String
  description    String         @default("")
  severity       Severity
  status         IncidentStatus @default(OPEN)
  assigneeId     String?
  createdBy      String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime?      @db.Timestamptz(3)
  resolvedAt     DateTime?      @db.Timestamptz(3)
  // Optimistic concurrency token: incremented on every mutation (BR-010).
  version        Int            @default(1)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  assignee     Membership?  @relation("IncidentAssignee", fields: [organizationId, assigneeId], references: [organizationId, userId])
  creator      Membership   @relation("IncidentCreator", fields: [organizationId, createdBy], references: [organizationId, userId])

  events      IncidentEvent[]
  occurrences AlertOccurrence[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, severity])
}

model IncidentEvent {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  actorId        String
  action         String
  beforeJson     Json?
  afterJson      Json?
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, incidentId, occurredAt])
}

// ---------------------------------------------------------------- alerts

model AlertRule {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  serviceId       String
  metricKey       String
  operator        AlertOperator
  threshold       Float
  windowSeconds   Int
  cooldownSeconds Int           @default(300)
  severity        Severity
  isEnabled       Boolean       @default(true)
  version         Int           @default(1)
  createdBy       String
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service          @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  metric       MetricDefinition @relation(fields: [metricKey], references: [key])
  creator      Membership       @relation(fields: [organizationId, createdBy], references: [organizationId, userId])

  occurrences AlertOccurrence[]

  @@unique([id, organizationId])
  @@index([organizationId, isEnabled])
}

model AlertOccurrence {
  id                String     @id @default(cuid())
  organizationId    String
  ruleId            String
  serviceId         String
  state             AlertState @default(FIRING)
  observedValue     Float
  triggeredAt       DateTime   @db.Timestamptz(3)
  clearedAt         DateTime?  @db.Timestamptz(3)
  // Identifies one alert episode so a rule cannot fire twice within it (BR-009).
  dedupeKey         String
  relatedIncidentId String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule            AlertRule    @relation(fields: [ruleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  relatedIncident Incident?    @relation(fields: [relatedIncidentId, organizationId], references: [id, organizationId])

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, state, triggeredAt(sort: Desc)])
}

// ---------------------------------------------------------------- notifications, audit, events

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  referenceType  String?
  referenceId    String?
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt(sort: Desc)])
}

// Append-only by convention: no update/delete endpoints exist (BR-014).
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  changesJson    Json?
  ipHash         String?
  requestId      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
}

// Transactional outbox: written in the same transaction as the business change and
// published to Socket.IO afterwards. `sequence` is monotonic per tenant (spec 11.4).
model EventOutbox {
  id             String    @id @default(cuid())
  organizationId String
  eventType      String
  aggregateId    String
  payload        Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt    DateTime? @db.Timestamptz(3)
  sequence       BigInt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sequence])
  @@index([publishedAt, createdAt])
}

// Per-tenant counter, incremented atomically in the same transaction as the outbox
// insert, so sequences are gap-free per tenant and never reused.
model EventSequence {
  organizationId String @id
  lastSequence   BigInt @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- demo simulator

// A synthetic incident injected into the telemetry of one service and region (FR-SIM-003).
// The simulator worker overrides the generated samples for the minutes the scenario covers.
model DemoScenario {
  id             String         @id @default(cuid())
  organizationId String
  serviceId      String
  region         String
  kind           ScenarioKind
  status         ScenarioStatus @default(RUNNING)
  startedById    String?
  startedAt      DateTime       @db.Timestamptz(3)
  // Planned end while running; the actual end once finished or cancelled.
  endsAt         DateTime       @db.Timestamptz(3)
  finishedAt     DateTime?      @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  startedBy    User?        @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt(sort: Desc)])
  @@index([organizationId, status])
}
